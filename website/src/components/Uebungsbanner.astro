---
interface Item { titel: string; href: string; info?: string; typ?: string }
interface Props { titel: string; items: Item[]; ki?: boolean; hinweis?: string }
const { titel, items, ki = false, hinweis } = Astro.props;
---
<aside class={`uebungsbanner ${ki ? 'ki' : ''}`} aria-label="Übungsblock">
  <div class="ub-kopf">
    <span class="ub-titel">✍️ {titel}</span>
    {ki
      ? <span class="pill erlaubt">✓ KI erlaubt</span>
      : <span class="pill frei" title="Bitte ohne KI-Unterstützung lösen">🚫 KI-frei lösen</span>}
  </div>
  <ul>
    {items.map((i) => (
      <li>
        <a href={i.href}><strong>{i.titel}</strong></a>
        {i.info && <span class="ub-info"> · {i.info}</span>}
        {i.typ && <span class="ub-typ">{i.typ}</span>}
      </li>
    ))}
  </ul>
  {hinweis && <p class="ub-hinweis">{hinweis}</p>}
</aside>
